{
  "name": "thai-rice-farming-simulator",
  "private": false,
  "version": "0.1.0",
  "description": "Interactive React simulator for Thai wet-season rice farming decisions.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "check": "npm run lint && npm test -- --run && npm run build",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"tests/**/*.js\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"tests/**/*.js\" \"*.{js,json,md}\"",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "playwright-core": "^1.61.1",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.6"
  },
  "overrides": {
    "esbuild": "^0.28.0"
  }
}
